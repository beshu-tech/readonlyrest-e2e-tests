# MIRROR is the registry prefix that the start script pulled the image below from, before the
# build. The build then finds the image on this machine. An empty MIRROR means Docker Hub.
# The start script reads the image name from the FROM line, so keep the `${MIRROR}library/` form.
ARG MIRROR=
FROM ${MIRROR}library/nginx:1.31@sha256:f9ea18bfa4fad859e1ed38259d711da7ccad2c3516e875cec3351a57c859f571

COPY conf/kbn/kbn-proxy-nginx.conf /etc/nginx/nginx.conf
COPY certs/kibana.key /etc/nginx/kibana/kibana.key
COPY certs/kibana.crt /etc/nginx/kibana/kibana.crt