{
  "name": "automatic-tests",
  "version": "1.0.0",
  "description": "Automatic tests for ReadonlyREST security plugin for Elasticsearch and Kibana",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "yarn lint -- --fix",
    "open": "./node_modules/.bin/cypress open",
    "run": "ELECTRON_ENABLE_LOGGING=1 ELECTRON_EXTRA_LAUNCH_ARGS='--ignore-gpu-blocklist' ./node_modules/.bin/cypress run",
    "tsCheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "license": "Beshu Limited, All rights reserved",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "@testing-library/cypress": "^10.0.3",
    "cypress": "15.20.1",
    "cypress-network-idle": "^1.15.0",
    "cypress-recurse": "1.37.2",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "node-fetch": "2.6.7",
    "semver": "7.5.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/node-fetch": "^2.6.11",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.6.2",
    "typescript": "7.0.2",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "esbuild": "^0.28.1",
    "esbuild-register": "^3.6.0",
    "typescript-legacy-api": "npm:typescript@6.0.3"
  },
  "engines": {
    "node": ">=24.11.0",
    "yarn": "^1.22.22"
  }
}
